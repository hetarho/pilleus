{
  "name": "pilleus",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @pilleus/db db:generate",
    "db:migrate": "pnpm --filter @pilleus/db db:migrate",
    "db:push": "pnpm --filter @pilleus/db db:push",
    "db:seed": "pnpm --filter @pilleus/db db:seed"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "packageManager": "pnpm@9.15.4"
}
